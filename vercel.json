{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.json", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/auth", "dest": "/api/auth.js" },
    { "src": "/api/callback", "dest": "/api/callback.js" },
    { "src": "/api/notion", "dest": "/api/notion.js" },
    { "src": "/api/gmail", "dest": "/api/gmail.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
